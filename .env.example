# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=        # From @BotFather
ADMIN_USER_ID=             # Your Telegram numeric user ID
SUPABASE_URL=              # https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=      # service_role key from Supabase → Settings → API

# ── AI Providers (at least one required) ──────────────────────────────────────
OPENROUTER_API_KEY=        # https://openrouter.ai — primary AI provider
GEMINI_API_KEY=            # https://ai.google.dev — fallback
HUGGINGFACE_API_KEY=       # https://huggingface.co/settings/tokens — image gen + fallback AI

# ── Optional AI overrides ─────────────────────────────────────────────────────
OPENROUTER_MODEL=openai/gpt-3.5-turbo
GEMINI_MODEL=gemini-1.5-flash
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ── Deployment control ────────────────────────────────────────────────────────
#
# IMPORTANT: Do NOT set ALLOW_POLLING in Replit or any non-Railway environment.
#
# Railway sets RAILWAY_ENVIRONMENT automatically — polling starts without any
# manual config on Railway.
#
# To test polling locally (e.g. on your own machine), set:
#   ALLOW_POLLING=true
# in your local .env file ONLY. Never set this in the Replit environment.
#
# ALLOW_POLLING=true     # ONLY for intentional local testing

# ── Onboarding / Community ────────────────────────────────────────────────────
# Set these in Railway env vars to enable the smart onboarding ecosystem.
# The bot must be an admin in the channel/group for membership verification.

TELEGRAM_CHANNEL_ID=       # @YourChannel or numeric ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_URL=      # https://t.me/YourChannel
TELEGRAM_CHANNEL_NAME=     # Display name shown in buttons (e.g. "FundzAi Channel")

TELEGRAM_GROUP_ID=         # @YourGroup or numeric ID
TELEGRAM_GROUP_URL=        # https://t.me/YourGroup
TELEGRAM_GROUP_NAME=       # Display name shown in buttons (e.g. "FundzAi Community")

# Bonus credits awarded when users join channel/group (defaults shown)
ONBOARDING_CHANNEL_REWARD_CHAT=5
ONBOARDING_CHANNEL_REWARD_IMAGE=1
ONBOARDING_GROUP_REWARD_CHAT=5
ONBOARDING_GROUP_REWARD_IMAGE=1

# Set to "true" to REQUIRE joining before using the bot (default: false = optional)
ONBOARDING_REQUIRED=false

# PORT is set automatically by Railway — do not set it manually
